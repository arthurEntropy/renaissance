{
  "name": "renaissance",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace @renaissance/backend dev\" \"yarn workspace @renaissance/frontend dev\"",
    "dev:frontend": "yarn workspace @renaissance/frontend dev",
    "dev:backend": "yarn workspace @renaissance/backend dev",
    "build": "yarn workspace @renaissance/frontend build",
    "start": "yarn workspace @renaissance/backend start",
    "lint": "yarn workspace @renaissance/frontend lint && yarn workspace @renaissance/backend lint",
    "install:all": "yarn install"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "overrides": {
    "qs": "^6.16.2",
    "body-parser": "^1.20.9",
    "ws": "^8.21.3",
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.3.3",
    "uuid": "^11.1.1",
    "@grpc/grpc-js": "^1.14.6",
    "dompurify": "^3.4.17",
    "prosemirror-state": "^1.4.4"
  },
  "resolutions": {
    "**/qs": "^6.16.2",
    "**/body-parser": "^1.20.9",
    "**/ws": "^8.21.3",
    "**/linkify-it": "^5.0.2",
    "**/markdown-it": "^14.3.3",
    "**/uuid": "^11.1.1",
    "**/@grpc/grpc-js": "^1.14.6",
    "**/dompurify": "^3.4.17",
    "**/prosemirror-state": "^1.4.4"
  }
}
